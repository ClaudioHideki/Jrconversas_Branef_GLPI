# Configure these values in the dedicated Branef Compose project in Dokploy.
# Never commit a filled file. Use independent random secrets for this installation.
BRANEF_DOMAIN=
JRC_IMAGE=
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
BRANEF_POSTGRES_PASSWORD=
