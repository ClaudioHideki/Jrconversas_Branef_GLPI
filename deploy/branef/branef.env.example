# Modelo SEM segredos. Preencher no Environment do Compose no Dokploy.
# Sugestao de endereco: branef.jrcws.cloud. Confirmar hostname e DNS antes do deploy.
# Informar somente hostname, sem https:// e sem barra.
BRANEF_DOMAIN=
JRC_IMAGE=
NICO_IMAGE=ghcr.io/claudiohideki/jrc-conversas-nico-v12-2-7-comercial-integrado-nico-runtime@sha256:70c7a048c26cb41e8974ef8f85d1e583aac85487d79d027ce44dc68c8e387337

# Somente numa instalacao NOVA, gerar valores INDEPENDENTES no servidor.
# Em atualizacoes, preservar todas as chaves/senhas/volumes existentes:
# SECRET_KEY_BASE: openssl rand -hex 64
# Cada outra chave/senha/token abaixo: executar openssl rand -hex 32 novamente.
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
BRANEF_POSTGRES_PASSWORD=
BRANEF_REDIS_PASSWORD=
NICO_SERVICE_TOKEN=

# Instalacao atual: a conta mantida BRANEF e ID 3.
# Em outra instalacao, confirmar o ID real antes de habilitar o NICO.
# Nunca usar * nem copiar IDs do LAB2; ID de conta difere de ID de usuario.
BRANEF_NICO_ACCOUNT_ID=3
NICO_PROVIDER_ALLOWED_HOSTS=api.openai.com

# Chave de IA, modelo e limites: configurar por conta na interface do JRC.
# Esta revisao exige o envelope de provedor enviado pelo Rails.
# Nao usar NICO_PROVIDER_API_KEY/NICO_MODEL como substitutos dessa configuracao.

JRC_SERVICE_DESK_INITIALIZER_USER_IDS=
# Referencia para bootstrap manual; nao cria usuario e nao e mapeada no Compose.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Bucket privado ja provisionado: 15 GiB compartilhados pela instalacao.
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=jrc-branef
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=br-east-1
STORAGE_ENDPOINT=https://s3.jrcws.cloud
STORAGE_FORCE_PATH_STYLE=true


# Limite por exportacao GLPI, em bytes. A cota do bucket tambem se aplica.
GLPI_EXPORT_MAX_BYTES=104857600
