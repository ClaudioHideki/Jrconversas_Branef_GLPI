BRANEF_REDIS_PASSWORD=
JRC_SERVICE_DESK_INITIALIZER_USER_IDS=
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
